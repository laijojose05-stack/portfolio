# ---------------------------------------------------------------------------
# Laijo Portfolio - environment variables
# Copy this file to ".env" and fill in values only when you need them.
# Never commit the real ".env" file. Never put secrets in public/js files.
# ---------------------------------------------------------------------------

# Local development port (Vercel ignores this value)
PORT=3000

# Optional: rate limiting for the contact form (per server instance)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Optional email delivery (Resend - https://resend.com)
# Without these values the site still runs. The contact form will honestly
# report that email delivery is not configured instead of pretending to send.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_TO_EMAIL=laijojose05@gmail.com
# CONTACT_FROM_EMAIL=Laijo Portfolio <onboarding@resend.dev>
#
# Notes:
# - The default "onboarding@resend.dev" sender only works for the Resend
#   account owner's own email address. Verify your own domain in Resend and
#   use an address on that domain for reliable delivery to anyone.
# - Add the same variables in Vercel: Project Settings -> Environment Variables.
